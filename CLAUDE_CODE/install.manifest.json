  "agentsCopy": {
    "description": "Active copy of the AGENTS kernel from playbook clone into the target project. Includes the kernel file (AGENTS.md) at project root AND the [APP]__*.md appendices in <PROJECT>/AGENTS/. The kernel file is what the project's CLAUDE.md @-imports first to bridge the AGENTS.md ↔ Claude Code gap; the appendices provide the modular methodology.",
    "kernelFile": {
      "source": "AGENTS.md",
      "dest": "<PROJECT>/AGENTS.md",
      "tokenSubstitution": false,
      "rationale": "AGENTS.md is the cross-tool kernel; project CLAUDE.md imports it via `@AGENTS.md` as the first line. Without this copy, the bridge resolves to a missing file and the kernel never loads."
    },
    "appendicesDir": {
      "sourceDir": "AGENTS/",
      "destDir": "<PROJECT>/AGENTS/",
      "files": [
        "[APP]__IMPLEMENTATION.md",
        "[APP]__API_DESIGN.md",
        "[APP]__STATIC_ANALYSIS.md",
        "[APP]__CHECKLISTS.md",
        "[APP]__TOOL_USAGE.md",
        "[APP]__DEPENDENCY_UPGRADES.md",
        "[APP]__PROJECT_SPECIFIC.md"
      ],
      "tokenSubstitution": { "[APP]": "<USER_PREFIX>" }
    }
  },
  "projectMemory": {
    "description": "Per-project auto-memory directory at the encoded-cwd path Claude Code uses internally.",
    "pathPattern": "~/.claude/projects/<encoded-cwd>/memory/",
    "encoding": "Replace every non-alphanumeric character in the absolute project path with '-'.",
    "files": [
      { "name": "MEMORY.md", "header": "# Memory Index — <project-name>" },
      { "name": "debugging.md", "header": "# Debugging Patterns — <project-name>" },
      { "name": "conventions.md", "header": "# Project Conventions — <project-name>" }
    ]
  },
  "settingsMerges": [
    {
      "target": "~/.claude/settings.json",
      "strategy": "json-merge-patch",
      "rfc": "RFC 7396",
      "patch": {
        "$schema": "https://json.schemastore.org/claude-code-settings.json",
        "includeCoAuthoredBy": false
      },
      "addedKeys": ["$schema", "includeCoAuthoredBy"],
      "backupBeforeWrite": true,
      "backupDir": "~/.claude/.architect-playbook-backups/"
    }
  ],
  "installReceipt": {
    "path": "~/.architect-playbook-manifest.json",
    "description": "Per-machine record of what this install actually wrote. Enables clean uninstall and verify."
  }
